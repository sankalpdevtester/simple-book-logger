datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Book {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  isbn      String?
  status    String   @default("TO_READ") // TO_READ, READING, COMPLETED
  rating    Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
